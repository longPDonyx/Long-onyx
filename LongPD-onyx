-- UI Builder Helpers
local Tabs = {}
local function CreateTab(name)
    local TabBtn = Instance.new("TextButton", Sidebar)
    TabBtn.Size = UDim2.new(1, 0, 0, 30)
    TabBtn.BackgroundTransparency = 1
    TabBtn.Text = "  " .. name
    TabBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    TabBtn.Font = Enum.Font.GothamMedium
    TabBtn.TextSize = 11
    TabBtn.TextXAlignment = Enum.TextXAlignment.Left

    local PageScroll = Instance.new("ScrollingFrame", ContentArea)
    PageScroll.Size = UDim2.new(1, -10, 1, -10)
    PageScroll.Position = UDim2.new(0, 5, 0, 5)
    PageScroll.BackgroundTransparency = 1
    PageScroll.Visible = false
    PageScroll.ScrollBarThickness = 3
    PageScroll.ScrollBarImageColor3 = Color3.fromRGB(255, 215, 0)

    local PageList = Instance.new("UIListLayout", PageScroll)
    PageList.SortOrder = Enum.SortOrder.LayoutOrder
    PageList.Padding = UDim.new(0, 6)

    TabBtn.MouseButton1Click:Connect(function()
        for _, tab in pairs(Tabs) do
            tab.Page.Visible = false
            tab.Btn.TextColor3 = Color3.fromRGB(150, 150, 150)
        end
        PageScroll.Visible = true
        TabBtn.TextColor3 = Color3.fromRGB(255, 215, 0)
    end)

    local Elements = {}

    function Elements:AddStatus(title, updateFunc)
        local Frame = Instance.new("Frame", PageScroll)
        Frame.Size = UDim2.new(1, 0, 0, 30)
        Frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
        Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 5)

        local Text = Instance.new("TextLabel", Frame)
        Text.Size = UDim2.new(1, 0, 1, 0)
        Text.Position = UDim2.new(0, 10, 0, 0)
        Text.TextColor3 = Color3.fromRGB(255, 255, 255)
        Text.Font = Enum.Font.GothamMedium
        Text.TextSize = 11
        Text.TextXAlignment = Enum.TextXAlignment.Left
        Text.BackgroundTransparency = 1

        task.spawn(function()
            while task.wait(0.8) do
                pcall(function()
                    Text.Text = title .. ": " .. tostring(updateFunc())
                end)
            end
        end)
    end

    function Elements:AddToggle(text, callback)
        local Frame = Instance.new("Frame", PageScroll)
        Frame.Size = UDim2.new(1, 0, 0, 32)
        Frame.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
        Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 5)

        local Label = Instance.new("TextLabel", Frame)
        Label.Text = "  " .. text
        Label.Size = UDim2.new(0.7, 0, 1, 0)
        Label.TextColor3 = Color3.fromRGB(240, 240, 240)
        Label.Font = Enum.Font.Gotham
        Label.TextSize = 11
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.BackgroundTransparency = 1

        local Btn = Instance.new("TextButton", Frame)
        Btn.Position = UDim2.new(0.78, 0, 0.15, 0)
        Btn.Size = UDim2.new(0.18, 0, 0.7, 0)
        Btn.Font = Enum.Font.GothamBold
        Btn.TextSize = 10
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 4)

        local state = false
        local function UpdateState()
            Btn.Text = state and "ON" or "OFF"
            Btn.BackgroundColor3 = state and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(40, 40, 40)
            Btn.TextColor3 = state and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(180, 180, 180)
        end
        UpdateState()

        Btn.MouseButton1Click:Connect(function()
            state = not state
            UpdateState()
            callback(state)
        end)
    end

    function Elements:AddButton(text, callback)
        local Btn = Instance.new("TextButton", PageScroll)
        Btn.Size = UDim2.new(1, 0, 0, 32)
        Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        Btn.Text = text
        Btn.TextColor3 = Color3.fromRGB(255, 215, 0)
        Btn.Font = Enum.Font.GothamBold
        Btn.TextSize = 11
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 5)

        Btn.MouseButton1Click:Connect(callback)
    end

    table.insert(Tabs, {Btn = TabBtn, Page = PageScroll})
    if #Tabs == 1 then
        PageScroll.Visible = true
        TabBtn.TextColor3 = Color3.fromRGB(255, 215, 0)
    end

    return Elements
end

