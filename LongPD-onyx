-- Equip Weapon Helper
local function EquipWeapon(type)
    local backpack = LocalPlayer.Backpack
    local char = LocalPlayer.Character
    if not char then return end
    
    for _, item in pairs(backpack:GetChildren()) do
        if item:IsA("Tool") then
            if type == "Melee" and item.ToolTip == "Melee" then
                char.Humanoid:EquipTool(item)
            elseif type == "Sword" and item.ToolTip == "Sword" then
                char.Humanoid:EquipTool(item)
            elseif type == "Fruit" and item.ToolTip == "Blox Fruit" then
                char.Humanoid:EquipTool(item)
            end
        end
    end
end

-- Level Check & Quest Helper
local function GetQuestData()
    local lvl = LocalPlayer.Data.Level.Value
    -- Ví dụ dữ liệu Quest rút gọn tự động nhận diện Sea
    if lvl < 10 then
        return "BanditQuest1", 1, "Bandit", CFrame.new(1059, 16, 1548)
    elseif lvl < 15 then
        return "JungleQuest", 1, "Monkey", CFrame.new(-1600, 36, 150)
    else
        return "TownQuest", 1, "Pirate", CFrame.new(-1140, 4, 3820)
    end
end

