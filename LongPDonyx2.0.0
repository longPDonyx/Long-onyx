-- DỮ LIỆU QUEST CHÍNH XÁC (SEA 1 - 3)
-- ================================================
local function GetQuestData()
    local lvl = GetPlayerLevel()
    local currentSea = GetCurrentSea()
    
    if currentSea == 1 then
        if lvl >= 700 then return "FountainQuest", 2, "Galley Captain", CFrame.new(5120, 40, 4050), CFrame.new(5650, 40, 4950) end
        if lvl < 10 then return "BanditQuest1", 1, "Bandit", CFrame.new(1059, 16, 1548), CFrame.new(1145, 17, 1634)
        elseif lvl < 15 then return "JungleQuest", 1, "Monkey", CFrame.new(-1600, 36, 153), CFrame.new(-1620, 22, 140)
        elseif lvl < 30 then return "JungleQuest", 2, "Gorilla", CFrame.new(-1600, 36, 153), CFrame.new(-1240, 6, -500)
        elseif lvl < 60 then return "BuggyQuest1", 1, "Pirate", CFrame.new(-1140, 4, 3828), CFrame.new(-1215, 4, 3910)
        elseif lvl < 90 then return "DesertQuest", 1, "Desert Bandit", CFrame.new(897, 6, 4388), CFrame.new(930, 6, 4480)
        elseif lvl < 120 then return "SnowQuest", 1, "Snow Bandit", CFrame.new(1385, 87, -1298), CFrame.new(1280, 105, -1380)
        elseif lvl < 150 then return "MarineQuest2", 1, "Chief Petty Officer", CFrame.new(-5030, 29, 4325), CFrame.new(-4800, 21, 4260)
        elseif lvl < 190 then return "SkyQuest", 1, "Sky Bandit", CFrame.new(-4840, 718, -2620), CFrame.new(-4980, 718, -2830)
        elseif lvl < 275 then return "PrisonerQuest", 1, "Prisoner", CFrame.new(530, 2, 475), CFrame.new(480, 3, 580)
        elseif lvl < 325 then return "ColosseumQuest", 1, "Toga Warrior", CFrame.new(-1580, 7, 2980), CFrame.new(-1800, 50, 2750)
        elseif lvl < 400 then return "MagmaQuest", 1, "Military Soldier", CFrame.new(-5310, 12, 8515), CFrame.new(-5400, 60, 8550)
        elseif lvl < 475 then return "FishmanQuest", 1, "Fishman Warrior", CFrame.new(61120, 18, 1560), CFrame.new(60800, 18, 1500)
        elseif lvl < 625 then return "SkyExp1Quest", 1, "God's Guard", CFrame.new(-4720, 845, -1950), CFrame.new(-4700, 845, -1900)
        else return "FountainQuest", 1, "Galley Pirate", CFrame.new(5120, 40, 4050), CFrame.new(5580, 40, 3980) end

    elseif currentSea == 2 then
        if lvl >= 1500 then return "ForgottenQuest", 1, "Sea Soldier", CFrame.new(-3055, 240, -10145), CFrame.new(-3000, 240, -10300) end
        if lvl < 775 then return "Area1Quest", 1, "Raider", CFrame.new(-425, 73, 1835), CFrame.new(-750, 73, 2400)
        elseif lvl < 875 then return "Area2Quest", 1, "Swan Pirate", CFrame.new(635, 73, 915), CFrame.new(880, 120, 1220)
        elseif lvl < 950 then return "MarineKingdomQuest", 1, "Marine Lieutenant", CFrame.new(-2440, 73, -3215), CFrame.new(-2800, 73, -3000)
        elseif lvl < 1100 then return "ZombieQuest", 1, "Zombie", CFrame.new(-5495, 48, -795), CFrame.new(-5600, 48, -950)
        elseif lvl < 1200 then return "SnowMountainQuest", 1, "Snow Trooper", CFrame.new(605, 400, -5370), CFrame.new(500, 400, -5500)
        elseif lvl < 1300 then return "IceSideQuest", 1, "Lab Subordinate", CFrame.new(-6060, 16, -4905), CFrame.new(-5750, 16, -4500)
        elseif lvl < 1425 then return "ShipQuest1", 1, "Ship Deckhand", CFrame.new(1030, 125, 32910), CFrame.new(1200, 125, 33000)
        else return "FrostQuest", 1, "Arctic Warrior", CFrame.new(5660, 28, -6480), CFrame.new(6000, 28, -6200) end

    elseif currentSea == 3 then
        if lvl < 1600 then return "PiratePortQuest", 1, "Pirate Millionaire", CFrame.new(-290, 44, 5580), CFrame.new(-300, 44, 5300)
        elseif lvl < 1700 then return "AmazonQuest", 1, "Female Islander", CFrame.new(5830, 52, -1105), CFrame.new(5700, 52, -900)
        elseif lvl < 1800 then return "MarineTreeQuest", 1, "Marine Commodore", CFrame.new(2180, 29, -6740), CFrame.new(2400, 29, -6800)
        elseif lvl < 1900 then return "DeepForestIslandQuest", 1, "Fishman Raider", CFrame.new(-13230, 332, -7625), CFrame.new(-13000, 332, -8000)
        elseif lvl < 2000 then return "HauntedQuest1", 1, "Reborn Skeleton", CFrame.new(-9480, 142, 5520), CFrame.new(-8800, 142, 5600)
        elseif lvl < 2100 then return "NutsIslandQuest", 1, "Peanut Scout", CFrame.new(-2100, 37, -10200), CFrame.new(-2000, 37, -10000)
        elseif lvl < 2200 then return "IceCreamIslandQuest", 1, "Ice Cream Chef", CFrame.new(-820, 65, -10965), CFrame.new(-600, 65, -11000)
        elseif lvl < 2400 then return "CakeQuest1", 1, "Cookie Crafter", CFrame.new(-2020, 37, -12025), CFrame.new(-2300, 37, -12000)
        elseif lvl < 2525 then return "TikiQuest1", 1, "Isle Outlaw", CFrame.new(-16535, 55, -1725), CFrame.new(-16300, 55, -1800)
        elseif lvl < 2650 then return "TikiQuest2", 1, "Sun-kissed Warrior", CFrame.new(-16535, 55, -1725), CFrame.new(-16800, 55, -1500)
        else return "TikiQuest2", 2, "Isle Champion", CFrame.new(-16535, 55, -1725), CFrame.new(-17000, 55, -1700) end
    end
    return nil
end

local function HasQuest()
    local mainUI = LocalPlayer.PlayerGui:FindFirstChild("Main")
    if mainUI then
        local questUI = mainUI:FindFirstChild("Quest")
        return questUI and questUI.Visible
    end
    return false
end

-- ================================================
-- SYSTEM: ADVANCED BRING MOB ENGINE
-- ================================================
task.spawn(function()
    while true do
        local delayTime = (_G.BringMobSpeed or 50) / 1000
        task.wait(delayTime)
        
        if _G.AutoFarmLevel and _G.BringMob then
            pcall(function()
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                
                local myPos = char.HumanoidRootPart.Position
                local _, _, mName = GetQuestData()
                local count = 0
                
                if mName and Workspace:FindFirstChild("Enemies") then
                    for _, mob in pairs(Workspace.Enemies:GetChildren()) do
                        if mob.Name == mName and mob:FindFirstChild("HumanoidRootPart") and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                            if (mob.HumanoidRootPart.Position - myPos).Magnitude <= 300 then
                                if count < (_G.MaxBringMobs or 3) then
                                    mob.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0, 0, -5)
                                    mob.HumanoidRootPart.Size = Vector3.new(40, 40, 40)
                                    mob.HumanoidRootPart.CanCollide = false
                                    mob.Humanoid.WalkSpeed = 0
                                    count = count + 1
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- ================================================
-- FAST ATTACK AUTO-DAMAGE ENGINE (REDZ HUB STYLE)
-- ================================================
local function GetAttackNet()
    if ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net") then
        return ReplicatedStorage.Modules.Net
    end
    return nil
end

local function GetEnemiesInRange()
    local targets = {}
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return targets end

    local myPos = char.HumanoidRootPart.Position

    if Workspace:FindFirstChild("Enemies") then
        for _, mob in pairs(Workspace.Enemies:GetChildren()) do
            local hrp = mob:FindFirstChild("HumanoidRootPart")
            local hum = mob:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                if (hrp.Position - myPos).Magnitude <= _G.AttackRange then
                    table.insert(targets, hrp)
                end
            end
        end
    end
    return targets
end

task.spawn(function()
    while task.wait(0.01) do
        if _G.FastAttack then
            pcall(function()
                local char = LocalPlayer.Character
                if not char then return end

                local weapon = char:FindFirstChildOfClass("Tool")
                if weapon and (weapon.ToolTip == "Melee" or weapon.ToolTip == "Sword" or weapon.ToolTip == "Blox Fruit") then
                    local targets = GetEnemiesInRange()
                    if #targets > 0 then
                        local net = GetAttackNet()
                        if net and net:FindFirstChild("RE/RegisterAttack") then
                            net["RE/RegisterAttack"]:FireServer(0.001)
                        end
                        if net and net:FindFirstChild("RE/RegisterHit") then
                            for _, targetHrp in pairs(targets) do
                                net["RE/RegisterHit"]:FireServer(targetHrp, {})
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- VÒNG LẶP CHÍNH AUTO FARM LEVEL
task.spawn(function()
    while task.wait(0.1) do
        pcall(function()
            local CommF = GetCommF()
            if _G.AutoFarmLevel and CommF then
                local qName, qNum, mName, npcCFrame, mobCFrame = GetQuestData()
                if qName then
                    if not HasQuest() then
                        SafeTo(npcCFrame)
                        if (LocalPlayer.Character.HumanoidRootPart.Position - npcCFrame.Position).Magnitude < 12 then
                            CommF:InvokeServer("StartQuest", qName, qNum)
                        end
                    else
                        local char = LocalPlayer.Character
                        if char and no
